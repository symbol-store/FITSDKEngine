+// Byte storage for field values with the subset of the std::vector interface FieldBase
+// uses. Values up to InlineCapacity bytes (nearly all fields) live inline, so decoding a
+// field does not allocate.
+class FieldValueBytes
+{
+public:
+    typedef FIT_BYTE* iterator;
+    typedef const FIT_BYTE* const_iterator;
+
+    FieldValueBytes() noexcept : heap(NULL), count(0), capacity(InlineCapacity) {}
+    FieldValueBytes(const FieldValueBytes& other) : FieldValueBytes() { Assign(other.data(), other.count); }
+    FieldValueBytes(FieldValueBytes&& other) noexcept : FieldValueBytes() { Steal(other); }
+    ~FieldValueBytes() { delete[] heap; }
+
+    FieldValueBytes& operator=(const FieldValueBytes& other)
+    {
+        if (this != &other)
+            Assign(other.data(), other.count);
+        return *this;
+    }
+
+    FieldValueBytes& operator=(FieldValueBytes&& other) noexcept
+    {
+        if (this != &other)
+        {
+            delete[] heap;
+            heap = NULL;
+            count = 0;
+            capacity = InlineCapacity;
+            Steal(other);
+        }
+        return *this;
+    }
+
+    size_t size() const { return count; }
+    FIT_BYTE* data() { return heap ? heap : inlineBytes; }
+    const FIT_BYTE* data() const { return heap ? heap : inlineBytes; }
+    iterator begin() { return data(); }
+    iterator end() { return data() + count; }
+    const_iterator begin() const { return data(); }
+    const_iterator end() const { return data() + count; }
+    FIT_BYTE& operator[](size_t i) { return data()[i]; }
+    const FIT_BYTE& operator[](size_t i) const { return data()[i]; }
+    FIT_BYTE& back() { return data()[count - 1]; }
+    void clear() { count = 0; }
+
+    void resize(size_t n)
+    {
+        Reserve(n);
+        if (n > count)
+            std::memset(data() + count, 0, n - count);
+        count = (FIT_UINT32)n;
+    }
+
+    void push_back(FIT_BYTE value)
+    {
+        Reserve(count + 1);
+        data()[count++] = value;
+    }
+
+    iterator insert(iterator pos, FIT_BYTE value) { return insert(pos, &value, &value + 1); }
+
+    iterator insert(iterator pos, const FIT_BYTE* first, const FIT_BYTE* last)
+    {
+        size_t index = pos - data();
+        size_t n = last - first;
+        Reserve(count + n);
+        std::memmove(data() + index + n, data() + index, count - index);
+        std::memcpy(data() + index, first, n);
+        count += (FIT_UINT32)n;
+        return data() + index;
+    }
+
+    iterator erase(iterator first, iterator last)
+    {
+        size_t n = last - first;
+        std::memmove(first, last, end() - last);
+        count -= (FIT_UINT32)n;
+        return first;
+    }
+
+private:
+    static const FIT_UINT32 InlineCapacity = 16;
+
+    void Reserve(size_t n)
+    {
+        if (n <= capacity)
+            return;
+        FIT_UINT32 newCapacity = (FIT_UINT32)((n > 2 * (size_t)capacity) ? n : 2 * (size_t)capacity);
+        FIT_BYTE* newHeap = new FIT_BYTE[newCapacity];
+        std::memcpy(newHeap, data(), count);
+        delete[] heap;
+        heap = newHeap;
+        capacity = newCapacity;
+    }
+
+    void Assign(const FIT_BYTE* bytes, size_t n)
+    {
+        Reserve(n);
+        std::memmove(data(), bytes, n);
+        count = (FIT_UINT32)n;
+    }
+
+    void Steal(FieldValueBytes& other)
+    {
+        if (other.heap)
+        {
+            heap = other.heap;
+            capacity = other.capacity;
+            other.heap = NULL;
+            other.capacity = InlineCapacity;
+        }
+        else
+        {
+            std::memcpy(inlineBytes, other.inlineBytes, other.count);
+        }
+        count = other.count;
+        other.count = 0;
+    }
+
+    FIT_BYTE* heap;
+    FIT_UINT32 count;
+    FIT_UINT32 capacity;
+    FIT_BYTE inlineBytes[InlineCapacity];
+};
