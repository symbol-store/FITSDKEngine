+Decode::RETURN Decode::EndMesgDefinition(void)
+{
+    const MesgDefinition& defn = localMesgDefs[localMesgIndex];
+    SkipPlan& plan = skipPlans[localMesgIndex];
+
+    plan = SkipPlan();
+
+    if (IsMesgWanted(defn.GetNum()))
+        return RETURN_MESG_DEF;
+
+    plan.skip = FIT_TRUE;
+
+    for (const FieldDefinition& fieldDefn : defn.GetFields())
+    {
+        if (fieldDefn.GetNum() == FIT_FIELD_NUM_TIMESTAMP)
+        {
+            // Decoding the timestamp updates the compressed timestamp reference. Only the
+            // common uint32 encoding is extracted while skipping; anything else is decoded.
+            if (Field(defn.GetNum(), FIT_FIELD_NUM_TIMESTAMP).IsValid())
+            {
+                if ((fieldDefn.GetType() == FIT_BASE_TYPE_UINT32) && (fieldDefn.GetSize() == 4))
+                    plan.timestampOffset = (FIT_SINT32)plan.size;
+                else
+                    plan.skip = FIT_FALSE;
+            }
+        }
+
+        plan.size += fieldDefn.GetSize();
+    }
+
+    // Developer fields follow the regular fields in the payload.
+    plan.size += defn.GetDeveloperFieldTotalSize();
+
+    return RETURN_MESG_DEF;
+}
+
+// Advances through a skipped payload, keeping the bytes of its timestamp field (if any)
+// in fieldData so the compressed timestamp reference can be updated at the end.
+void Decode::ConsumeSkipped(const FIT_UINT8* data, FIT_UINT32 count)
+{
+    FIT_SINT32 timestampOffset = skipPlans[localMesgIndex].timestampOffset;
+
+    if (timestampOffset >= 0)
+    {
+        for (FIT_UINT32 i = 0; i < count; i++)
+        {
+            FIT_SINT32 timestampByte = (FIT_SINT32)(skipIndex + i) - timestampOffset;
+            if ((timestampByte >= 0) && (timestampByte < 4))
+                fieldData[timestampByte] = data[i];
+        }
+    }
+
+    skipIndex += count;
+}
+
+Decode::RETURN Decode::BeginSkip(void)
+{
+    skipIndex = 0;
+
+    if (skipPlans[localMesgIndex].size == 0)
+        return RETURN_MESG_SKIPPED;
+
+    state = STATE_SKIP;
+    return RETURN_CONTINUE;
+}
