+// Byte-at-a-time table for the same CRC-16 (reflected polynomial 0xA001) that Get16
+// computes a nibble at a time; used for bulk updates over skipped message payloads.
+static constexpr struct CRCByteTable
+{
+   FIT_UINT16 entries[256];
+
+   constexpr CRCByteTable() : entries()
+   {
+      for (int i = 0; i < 256; i++)
+      {
+         FIT_UINT16 crc = (FIT_UINT16)i;
+         for (int bit = 0; bit < 8; bit++)
+            crc = (crc & 1) ? (FIT_UINT16)((crc >> 1) ^ 0xA001) : (FIT_UINT16)(crc >> 1);
+         entries[i] = crc;
+      }
+   }
+} crcByteTable;
+
+FIT_UINT16 CRC::Update16(FIT_UINT16 crc, const void *data, FIT_UINT32 size)
+{
+   const FIT_BYTE *data_ptr = (const FIT_BYTE *)data;
+
+   while (size--)
+      crc = (FIT_UINT16)((crc >> 8) ^ crcByteTable.entries[(crc ^ *data_ptr++) & 0xFF]);
+
+   return crc;
+}
