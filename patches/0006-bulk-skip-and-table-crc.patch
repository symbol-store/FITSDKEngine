+// Consumes as much of a skipped payload as is available in one go, leaving the final
+// byte (and the file CRC) to ReadByte so message completion is handled in one place.
+FIT_UINT32 Decode::SkipBulk(const FIT_UINT8* data, FIT_UINT32 size)
+{
+    FIT_UINT32 count = skipPlans[localMesgIndex].size - skipIndex - 1;
+
+    if (count > size)
+        count = size;
+
+    if ((fileBytesLeft > 0) && (skipHeader == FIT_FALSE))
+    {
+        if (fileBytesLeft <= 2)
+            return 0;
+        if (count > fileBytesLeft - 2)
+            count = fileBytesLeft - 2;
+        crc = CRC::Update16(crc, data, count);
+        fileBytesLeft -= count;
+    }
+
+    ConsumeSkipped(data, count);
+    return count;
+}
