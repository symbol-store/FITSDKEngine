+    // Filters are tiny and this runs once per definition or decoded message.
+    return mesgFilter.empty()
+        || (std::find(mesgFilter.begin(), mesgFilter.end(), mesgNum) != mesgFilter.end())
+        || (mesgNum == FIT_MESG_NUM_DEVELOPER_DATA_ID)
